# --- Database -------------------------------------------------------------
# PostgreSQL. On Replit, create a Database (PostgreSQL) and paste its
# DATABASE_URL secret here (Replit sets it automatically in deployments).
# Local options (see README "Database setup"):
#   docker run --name nicfinder-pg -e POSTGRES_USER=nicfinder \
#     -e POSTGRES_PASSWORD=nicfinder_dev -e POSTGRES_DB=nicfinder \
#     -p 5432:5432 -d postgres:16
DATABASE_URL="postgresql://nicfinder:nicfinder_dev@localhost:5432/nicfinder"

# Tests use a separate throwaway database (name must contain "test"):
# TEST_DATABASE_URL="postgresql://nicfinder:nicfinder_dev@localhost:5432/nicfinder_test"

# --- Sessions ---------------------------------------------------------------
# Server secret, used as the salt for hashed IPs (corroboration independence
# and coverage-request dedupe). Sessions are random DB-backed tokens and do not
# depend on it. Changing it changes every IP hash, so rotate deliberately.
# Generate one:  openssl rand -hex 32
SESSION_SECRET="change-me-generate-a-real-secret"

# --- Base URL ---------------------------------------------------------------
APP_URL="http://localhost:3000"

# --- Google OAuth (OPTIONAL — login with Google is hidden until configured) -
# Create credentials at https://console.cloud.google.com/apis/credentials
# Authorized redirect URI: ${APP_URL}/api/auth/google/callback
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# --- Replit Auth (PRODUCTION ON REPLIT ONLY) --------------------------------
# Set to "true" ONLY in the Replit deployment (see REPLIT.md). It makes the
# app trust Replit's X-Replit-User-* identity headers, which are verified by
# Replit's proxy there and forgeable anywhere else. Never enable locally.
REPLIT_AUTH_ENABLED="false"

# --- Geocoding --------------------------------------------------------------
# Street-address geocoding uses the public OSM Nominatim API (1 req/sec,
# cached). ZIP-code search works fully offline from the bundled dataset.
# Set to "false" to disable network geocoding (ZIP-only / demo mode).
NOMINATIM_ENABLED="true"
# Identify the app to Nominatim per their usage policy (no personal email).
NOMINATIM_USER_AGENT="nicfinder-dev"

# --- Rate limiting ----------------------------------------------------------
# "memory" (default): per-process sliding window — fine for single-instance
# deployments and local dev, no infrastructure needed.
# "db": shared sliding window in Postgres (RateLimitEvent table) — set this
# on multi-instance deployments (e.g. Replit Autoscale) so limits hold
# across processes. The maintenance job prunes old events.
RATE_LIMIT_BACKEND="memory"

# --- Automated import API -----------------------------------------------------
# Bearer key for POST /api/imports (programmatic CSV/XLSX handoff, e.g. the
# future calling pipeline). UNSET = endpoint disabled (404). 16+ chars.
# Generate: openssl rand -hex 24
IMPORT_API_KEY=""
# Optional HTTPS webhook receiving batch status pushes (import.committed /
# import.reversed). UNSET = no outbound calls. Deliveries are HMAC-signed
# with IMPORT_API_KEY in X-NicFinder-Signature when that key is set.
IMPORT_WEBHOOK_URL=""

# --- Demo mode --------------------------------------------------------------
# Shows the "demonstration data" banner. Keep "true" until real observations
# are imported.
DEMO_MODE="true"
