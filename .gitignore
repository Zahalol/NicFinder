# dependencies
node_modules/

# next.js
.next/
out/
next-env.d.ts

# production
build/

# env — never commit secrets
.env
.env.local
.env*.local

# database (local SQLite lives in prisma/, generated at setup)
# (legacy sqlite files)
prisma/*.db
# (legacy sqlite files)
prisma/*.db-journal

# geocode cache
.cache/

# testing (anchored to root — `coverage/` bare would also ignore
# src/app/admin/coverage/, which silently dropped that page once)
/coverage/
test-results/

# uploads stored at runtime
var/uploads/

# misc
.DS_Store
*.pem
*.tsbuildinfo

# NEVER commit the original workbook (contained credentials)
*.xlsx
!sample-data/*.xlsx
